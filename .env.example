GNANI_API_KEY_ID="YOUR API KEY"
GNANI_STT_MODEL=prisma-v2.5
GNANI_STT_URL=https://api.vachana.ai/stt/v3

# Supply real connection settings and random secrets in private .env before startup.
APP_ENV=development
PUBLIC_JUDGE_DEMO_ENABLED=false
DATABASE_URL=postgresql+psycopg://fieldsaarthi:REPLACE_LOCAL_DB_PASSWORD@127.0.0.1:55432/fieldsaarthi
TEST_DATABASE_URL=postgresql+psycopg://fieldsaarthi:REPLACE_LOCAL_DB_PASSWORD@127.0.0.1:55432/fieldsaarthi_test
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GNANI_TTS_ENABLED=false
DEMO_WORKER_PASSWORD=
DEMO_WORKER2_PASSWORD=
DEMO_SUPERVISOR_PASSWORD=
